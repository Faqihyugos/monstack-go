[Unit]
Description=MonStack-Go Monitoring Agent
Documentation=https://github.com/yourusername/monstack-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/monstack-agent --config /etc/monstack/agent.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monstack-agent

[Install]
WantedBy=multi-user.target
